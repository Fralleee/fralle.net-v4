---
import type { EntryCardView } from "./entry-card-view";
import { Sparkline } from "./Sparkline";

type Props = EntryCardView;

const { period, logo, title, url, rows = [], details, sparkline, tags, links, featured } = Astro.props;

function parseInlineBold(text: string): Array<{ text: string; bold: boolean }> {
  const segments: Array<{ text: string; bold: boolean }> = [];
  const regex = /\*\*(.+?)\*\*/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = regex.exec(text)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ text: text.slice(lastIndex, match.index), bold: false });
    }
    segments.push({ text: match[1] ?? "", bold: true });
    lastIndex = regex.lastIndex;
  }
  if (lastIndex < text.length) {
    segments.push({ text: text.slice(lastIndex), bold: false });
  }
  return segments;
}
---

<article class:list={["entry", featured && "entry-featured"]}>
  {featured && <span class="featured-flag">{featured.badge}</span>}
  <div class="grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-[110px_1fr]">
    <div class="flex flex-col items-start gap-3 md:items-center md:gap-4">
      {
        period && (
          <span class:list={["entry-period", period.live && "entry-period-live"]}>{period.text}</span>
        )
      }
      <div class="entry-logo" style={logo.scale ? `--logo-scale: ${logo.scale}` : undefined}>
        <img src={logo.src} alt="" width="56" height="56" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="min-w-0">
      <h3 class="entry-title">
        <a href={url} target="_blank" rel="noopener noreferrer">
          {title.text}{title.suffix && ` · ${title.suffix}`}
        </a>
        <span class="entry-arrow" aria-hidden="true">→</span>
      </h3>
      {
        rows.map((row) => (
          <div class="entry-sub">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {row.icon === "location" && (
                <>
                  <path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </>
              )}
              {row.icon === "kind-web" && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18" />
                  <path d="M12 3a14 14 0 0 1 4 9 14 14 0 0 1-4 9 14 14 0 0 1-4-9 14 14 0 0 1 4-9Z" />
                </>
              )}
              {row.icon === "kind-extension" && (
                <>
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </>
              )}
              {row.icon === "kind-game" && (
                <>
                  <rect x="2" y="7" width="20" height="11" rx="3" />
                  <path d="M6 12.5h4M8 10.5v4" />
                  <circle cx="15.5" cy="11.5" r="0.6" fill="currentColor" />
                  <circle cx="18" cy="13.5" r="0.6" fill="currentColor" />
                </>
              )}
              {row.icon === "subtitle" && <circle cx="12" cy="12" r="3" />}
            </svg>
            <span>{row.text}</span>
          </div>
        ))
      }
      {
        details
          .split("\n\n")
          .filter((para) => para.trim())
          .map((para) => (
            <p class="entry-details">
              {parseInlineBold(para).map((seg) => (seg.bold ? <strong>{seg.text}</strong> : seg.text))}
            </p>
          ))
      }
      {
        sparkline && (
          <Sparkline posthogId={sparkline.posthogId} label={sparkline.label} client:visible />
        )
      }
      <ul class="entry-tags">
        {tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
      {
        links && links.length > 0 && (
          <ul class="entry-links">
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
