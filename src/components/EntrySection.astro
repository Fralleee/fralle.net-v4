---
import type { EntryCardView } from "./entry-card-view";
import EntryCard from "./EntryCard.astro";
import Section from "./Section.astro";

interface Props {
  id: string;
  label: string;
  title: string;
  count?: string;
  items: readonly EntryCardView[];
}

const { id, label, title, count, items } = Astro.props;
---

<Section id={id} label={label} title={title} count={count}>
  <ul class="entries">
    {
      items.map((item) => (
        <li>
          <EntryCard {...item} />
        </li>
      ))
    }
  </ul>
</Section>
