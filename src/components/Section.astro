---
interface Props {
  id: string;
  label: string;
  title: string;
  count?: string;
}

const { id, label, title, count } = Astro.props;
---

<section
  id={id}
  class="mb-20 grid scroll-mt-20 gap-x-12 gap-y-6 border-t border-dashed border-rule pt-6 first-of-type:border-t-0 first-of-type:pt-0 md:grid-cols-[220px_1fr]"
>
  <div class="flex flex-col items-start gap-2.5 md:sticky md:top-8">
    <span
      class="whitespace-nowrap rounded bg-ink/10 px-2 py-1 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-ink"
    >
      {label}
    </span>
    <h2 class="m-0 text-balance text-[28px] font-bold leading-[1.15] tracking-tight text-fg-1 md:text-[32px]">
      {title}
    </h2>
    {count && <span class="whitespace-nowrap font-mono text-xs text-fg-3">{count}</span>}
  </div>
  <div class="min-w-0">
    <slot />
  </div>
</section>
