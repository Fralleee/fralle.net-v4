          href={link.href}
          aria-label={link.label}
          title={link.label}
          rel="noopener"
          target="_blank"
          class="inline-flex h-[38px] w-[38px] items-center justify-center rounded-md border-[1.5px] border-ink/85 bg-canvas text-fg-1 no-underline shadow-stamp-lg transition-[transform,box-shadow,background-color,color] duration-[120ms] hover:bg-fg-1 hover:text-canvas active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]">
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
