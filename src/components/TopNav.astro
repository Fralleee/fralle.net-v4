---
import { available } from "../data/availability";

const sections = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#articles", label: "Articles" },
];
---

<nav class="sticky top-0 z-50 border-b border-ink/10 bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-8 py-3.5">
    <a
      href="/"
      class="inline-flex items-center gap-2.5 text-[15px] font-bold tracking-[-0.01em] text-fg-1 no-underline"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-[22px] w-[22px] items-center justify-center rounded border-[1.5px] border-ink/85 bg-ink font-mono text-[13px] font-bold text-canvas shadow-stamp"
      >
        f
      </span>
      <span class="whitespace-nowrap">Roland Chelwing</span>
      <span class="mx-0.5 hidden font-medium text-ink/40 md:inline">/</span>
      <span class="hidden font-mono text-[14px] font-semibold text-ink/70 md:inline">fralle.net</span>
    </a>

    <ul
      class="m-0 hidden list-none items-center gap-5 p-0 font-mono text-xs uppercase tracking-[0.05em] md:flex"
      aria-label="Sections"
    >
      {
        sections.map((s) => (
          <li>
            <a
              href={s.href}
              class="text-ink/65 no-underline transition-colors duration-[120ms] hover:text-fg-1"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.05em] text-ink/65">
      {
        available && (
          <span
            aria-hidden="true"
            class="block h-2 w-2 rounded-full bg-pulse animate-status-pulse motion-reduce:animate-none"
          />
        )
      }
      <span class="md:hidden">{available ? "Available" : "Sweden"}</span>
      <span class="hidden md:inline">
        {available ? "Available for hire · Sweden (Remote)" : "Sweden (Remote)"}
      </span>
    </div>
  </div>
</nav>
