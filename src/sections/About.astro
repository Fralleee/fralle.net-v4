---
import Section from "../components/Section.astro";
import { available } from "../data/availability";
---

<Section id="about" label="01 — About" title="About">
  <div class="prose-block text-fg-1">
    <p>
      I started programming at the <span class="paint-rect">age of seven</span>, creating text-based RPGs
      with my older brother on an ancient PASCAL computer. Computers and technology have always fascinated me,
      but it wasn't until many years later that I turned my passion into a profession.
    </p>
    <p>
      Over the years, I have had the opportunity to work with a diverse range of organizations, including a <a
        href="https://www.aptic.net/"
        rel="noopener noreferrer"
        target="_blank">fintech company</a
      >, an <a href="https://www.gamesysgroup.com/" rel="noopener noreferrer" target="_blank">online casino platform</a>,
      a <a href="https://www.yubico.com/" rel="noopener noreferrer" target="_blank">security company</a>, a <a
        href="https://www.getharley.com/"
        rel="noopener noreferrer"
        target="_blank">skincare platform</a
      >, and <a href="https://stackoverflow.com/" rel="noopener noreferrer" target="_blank"
        >one of the world's most visited websites</a
      >.
    </p>
    {
      available && (
        <p>
          Currently seeking new opportunities, I am passionate about software development and am
          eager to bring my expertise to a new team.
        </p>
      )
    }
    {
      available ? (
        <p>
          Please feel free to contact me on{" "}
          <a href="https://www.linkedin.com/in/fralle/" rel="noopener noreferrer" target="_blank">
            LinkedIn
          </a>{" "}
          or via <a href="mailto:roland.chelwing@gmail.com">email</a> to discuss potential
          collaborations or job openings.
        </p>
      ) : (
        <p>
          You'll find me on{" "}
          <a href="https://www.linkedin.com/in/fralle/" rel="noopener noreferrer" target="_blank">
            LinkedIn
          </a>
          , or you can <a href="mailto:roland.chelwing@gmail.com">email</a> me directly. Always
          happy to talk shop.
        </p>
      )
    }
  </div>
</Section>
