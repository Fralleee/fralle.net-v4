---
import EntryCard from "../components/EntryCard.astro";
import Section from "../components/Section.astro";
import { articles } from "../data/articles";

const count = `${articles.length} posts · Medium`;
---

<Section id="articles" label="04 — Articles" title="Things I've written" count={count}>
  <ul class="entries">
    {
      articles.map((a) => (
        <li>
          <EntryCard {...a} />
        </li>
      ))
    }
  </ul>
</Section>
