---
import EntrySection from "../components/EntrySection.astro";
import { articleToCardView, articles } from "../data/articles";

const count = `${articles.length} posts · Medium`;
const items = articles.map(articleToCardView);
---

<EntrySection
  id="articles"
  label="04 — Articles"
  title="Things I've written"
  count={count}
  items={items}
/>
