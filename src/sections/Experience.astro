---
import EntrySection from "../components/EntrySection.astro";
import { experienceToCardView, experiences } from "../data/experiences";

const startYears = experiences.map((e) => Number.parseInt(e.period, 10)).filter(Number.isFinite);
const earliest = Math.min(...startYears);
const years = new Date().getFullYear() - earliest;
const count = `${experiences.length} roles · ${years}+ years`;
const items = experiences.map(experienceToCardView);
---

<EntrySection
  id="experience"
  label="02 — Experience"
  title="Where I've shipped"
  count={count}
  items={items}
/>
