---
import EntrySection from "../components/EntrySection.astro";
import { experienceToCardView, experiences, getCareerYears } from "../data/experiences";

const count = `${experiences.length} roles · ${getCareerYears()}+ years`;
const items = experiences.map(experienceToCardView);
---

<EntrySection
  id="experience"
  label="02 — Experience"
  title="Track record"
  count={count}
  items={items}
/>
