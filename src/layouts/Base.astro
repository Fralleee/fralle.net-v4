---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schemas?: ReadonlyArray<Record<string, unknown>>;
}

const {
  title = "Roland Chelwing — Fullstack Software Engineer",
  description = "Roland Chelwing — fullstack software engineer based in Sweden.",
  noindex = false,
  schemas = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const enableTracking =
  import.meta.env.PROD &&
  Boolean(import.meta.env.PUBLIC_POSTHOG_KEY) &&
  Boolean(import.meta.env.PUBLIC_POSTHOG_HOST);

const personSchema = {
  "@type": "Person",
  "@id": new URL("#person", Astro.site).href,
  name: "Roland Chelwing",
  jobTitle: "Fullstack Software Engineer",
  url: Astro.site?.href,
  sameAs: [
    "https://github.com/Fralleee/",
    "https://www.linkedin.com/in/fralle/",
    "https://medium.com/@fralle/",
    "https://dev.to/fralleee",
  ],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [personSchema, ...schemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {enableTracking && <script>import "../lib/analytics";</script>}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f1ea" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roland Chelwing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="absolute left-0 top-2 z-[60] -translate-x-full bg-amber-300 px-3 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-fg-1 no-underline transition-transform duration-150 focus-visible:translate-x-2 focus-visible:text-fg-1"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
