{
  "name": "fralle-net",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "icons": "bun scripts/generate-icons.ts",
    "og": "bun scripts/generate-og.tsx",
    "assets": "bun run icons && bun run og",
    "predev": "bun run assets",
