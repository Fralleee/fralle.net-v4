    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@tailwindcss/vite": "4.2.4",
    "astro": "6.2.2",
    "posthog-js": "1.372.10",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.4.14",
    "@fontsource/inter": "5.2.8",
    "@happy-dom/global-registrator": "20.9.0",
