    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/og": "0.11.1",
    "fallow": "^2.87.0",
    "lefthook": "2.1.6",
    "png-to-ico": "3.0.1",
    "typescript": "6.0.3"
