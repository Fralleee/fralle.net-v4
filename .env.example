# Drives the TopNav status row, HeaderRail availability badge, and the
# About section's job-seeking copy. Only the literal value "true" turns
# them on; any other value (or unset) renders the not-currently-looking
# variant. Toggle on Vercel via Settings -> Environment Variables and
# trigger a redeploy.
PUBLIC_AVAILABLE_FOR_HIRE=false

# Client-side PostHog tracking on the deployed site (pageviews +
# autocaptured clicks). The Base layout only emits the snippet when
# import.meta.env.PROD is true AND both vars are set, so leave them
# scoped to the Production environment in Vercel — Preview deploys and
# `bun dev` will stay quiet automatically. The PUBLIC_ prefix exposes
# them to the client at build time. Use the *project* key (phc_...),
# never the personal API key.
PUBLIC_POSTHOG_KEY=phc_...
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Read by the /api/sparkline/[id] route at request time to fetch the
# project sparkline data from PostHog. The personal API key needs the
# `insight:read` scope (generate at
# https://eu.posthog.com/settings/user-api-keys). Server-only — never
# exposed to the client. When any of these are unset the route returns
# 503 and the Sparkline island falls back to its error state without
# breaking layout.
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_API_KEY=phx_...
POSTHOG_PROJECT_ID=...
